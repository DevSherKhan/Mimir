# Hosted server
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
DATABASE_URL=postgresql://mimir:mimir@localhost:5432/mimir
MIMIR_DOCS_ENABLED=true

# Local agent
# MIMIR_HOME=/absolute/path/to/private/mimir-data
MIMIR_CLOUD_URL=http://localhost:3000
MIMIR_EMBEDDING_PROVIDER=dev

# Required only when MIMIR_EMBEDDING_PROVIDER=openai
OPENAI_API_KEY=

# Development-only emergency access. Keep disabled in production.
MIMIR_ALLOW_DEV_TOKEN=false
MIMIR_DEV_ACCESS_TOKEN=
MIMIR_DEV_USER_ID=dev-user
