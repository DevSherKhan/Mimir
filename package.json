{
  "name": "mimir-chat-index",
  "version": "0.1.1",
  "description": "Local-first AI chat memory index exposed through a CLI and MCP server.",
  "keywords": [
    "ai",
    "memory",
    "mcp",
    "model-context-protocol",
    "codex",
    "claude",
    "cursor"
  ],
  "homepage": "https://devsherkhan.github.io/Mimir/",
  "bugs": {
    "url": "https://github.com/DevSherKhan/Mimir/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DevSherKhan/Mimir.git"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "mimir": "dist/local/cli/index.js"
  },
  "scripts": {
    "build": "npm run clean && npm run build:dashboard && tsc -p tsconfig.json",
    "build:dashboard": "node ./node_modules/vite/bin/vite.js build --config dashboard/vite.config.ts",
    "build:docs": "node ./node_modules/vite/bin/vite.js build --config docs/vite.config.ts",
    "check": "npm run typecheck && npm test && npm run build && npm run build:docs",
    "clean": "node -e \"const fs = require('node:fs'); for (const path of ['dist', 'dist-dashboard', 'dist-docs']) fs.rmSync(path, { recursive: true, force: true })\"",
    "dev": "tsx src/local/cli/index.ts",
    "dev:dashboard": "node ./node_modules/vite/bin/vite.js --config dashboard/vite.config.ts",
    "dev:docs": "node ./node_modules/vite/bin/vite.js --config docs/vite.config.ts",
    "start": "node --env-file-if-exists=.env dist/server/index.js",
    "dev:server": "node --env-file-if-exists=.env --import tsx src/server/index.ts",
    "prepack": "npm run check",
    "release:check": "npm run check && npm pack --dry-run --ignore-scripts --cache .tmp/npm-cache",
    "preview:docs": "node ./node_modules/vite/bin/vite.js preview --config docs/vite.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p dashboard/tsconfig.json --noEmit && tsc -p docs/tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@fastify/formbody": "^8.0.2",
    "@fastify/static": "^9.1.3",
    "@modelcontextprotocol/sdk": "^1.13.0",
    "@tailwindcss/vite": "^4.3.2",
    "@vitejs/plugin-react": "^5.2.0",
    "better-sqlite3": "^11.10.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "commander": "^12.1.0",
    "fastify": "^5.9.0",
    "lucide-react": "^1.14.0",
    "openai": "^5.8.2",
    "pg": "^8.22.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "sqlite-vec": "^0.1.6",
    "swagger-ui-dist": "^5.29.4",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.3.2",
    "vite": "^7.3.6",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^26.1.2",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "tsx": "^4.20.3",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "author": "DevSherKhan",
  "license": "ISC",
  "files": [
    "dist/",
    "dist-dashboard/",
    "cloud/migrations/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
